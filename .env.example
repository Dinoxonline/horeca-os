NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Use the Supabase project secret key; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Server-side only. Never prefix with NEXT_PUBLIC_ and never store in Supabase.
OPENAI_API_KEY=
# Cost-conscious default; override per environment after evaluation.
OPENAI_MODEL=gpt-5.6-terra

# Meta / Instagram Login. All values are server-side only.
# Instagram Login uses its own App ID and secret. Do not substitute META_APP_ID.
META_APP_ID=2231952860937833
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_REDIRECT_URI=https://your-domain.example/api/integrations/meta/callback
# Generate a long random value for signed OAuth state.
META_OAUTH_STATE_SECRET=
# Exactly 32 random bytes encoded as base64.
META_TOKEN_ENCRYPTION_KEY=

# WhatsApp Business App coexistence through Meta Embedded Signup.
# Create this configuration after Meta Business Verification and App Review.
WHATSAPP_CONFIG_ID=
WHATSAPP_REDIRECT_URI=https://your-domain.example/koppelingen
# Secret webhook handshake value; never expose this in client-side code.
WHATSAPP_VERIFY_TOKEN=
# Optional separate secret. When omitted, META_APP_SECRET is used for webhook signatures.
WHATSAPP_APP_SECRET=

# Predis.ai content generation. Both values are server-side only.
PREDIS_API_KEY=
# Long random value included only in the server-side webhook URL.
PREDIS_WEBHOOK_SECRET=
