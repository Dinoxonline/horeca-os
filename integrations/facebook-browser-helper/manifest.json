{
  "manifest_version": 3,
  "name": "Horeca OS Facebookgroepen-helper",
  "version": "1.2.2",
  "description": "Deelt een gekoppeld Horeca OS Facebook-evenement gecontroleerd in de gekozen Facebookgroepen.",
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://horeca-os-iota.vercel.app/*", "https://horeca-os-le-club.vercel.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://horeca-os-iota.vercel.app/*", "https://horeca-os-le-club.vercel.app/*"],
      "js": ["horeca-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.facebook.com/groups/*", "https://facebook.com/groups/*", "https://www.facebook.com/events/*", "https://facebook.com/events/*"],
      "js": ["facebook-group.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Horeca OS Facebookgroepen-helper" }
}
